{
  "name": "@libid/ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "dev": "pnpm --filter @libid/dev dev",
    "dev:services": "pnpm --filter @libid/dev dev:services",
    "dev:app": "pnpm --filter @libid/dev dev:app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
