{
  "name": "@libid/claim-full",
  "version": "0.4.0",
  "description": "@libid/claim plus every static proving asset it loads at runtime, bundled in the npm tarball: the tlsn wasm bundle, the released compiled circuits (sha256-verified), and noir's acvm/abi wasm. One install, no staging scripts, no curl.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libid-org/libID.git",
    "directory": "ts/packages/claim-full"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "assets",
    "!assets/.stamp.json",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "bin": {
    "libid-claim-assets": "./bin/libid-claim-assets.mjs"
  },
  "scripts": {
    "build": "node scripts/fetch-assets.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "libid": {
    "notaryRelease": "v0.2.0",
    "circuitsRelease": "v0.2.0"
  },
  "dependencies": {
    "@libid/claim": "workspace:^"
  },
  "devDependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260324",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
