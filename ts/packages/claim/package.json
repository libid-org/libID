{
  "name": "@libid/claim",
  "version": "0.4.0",
  "description": "Browser library for the libID OAuth handle-claim flows (GitHub, X, Google): drive the consent popup, prove control of the account, and encode a bind-ready proof for IdentityNames.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libid-org/libID.git",
    "directory": "ts/packages/claim"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/google/fixtures"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260324",
    "@libid/contracts": "^0.5.0",
    "@noir-lang/acvm_js": "1.0.0-beta.20",
    "@noir-lang/noir_js": "1.0.0-beta.20",
    "@noir-lang/noirc_abi": "1.0.0-beta.20"
  },
  "peerDependencies": {
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "viem": "^2.48.11",
    "vitest": "^3.2.0"
  }
}
