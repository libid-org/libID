{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // fetch, Response and URL; the client runs in browsers and Node.
    "lib": ["ES2022", "DOM"],
    // The tests run under Node; the build does not.
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
