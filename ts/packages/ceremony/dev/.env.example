# Copy to dev/.env.local. Only these two origins are embedded in the browser app.
CEREMONY_BRIDGE_ORIGIN=https://localhost:4682
CEREMONY_CCDP_ORIGIN=https://localhost:4683
CEREMONY_APP_PORT=4691
# Optional certificate/key (absolute paths) to bypass automatic mkcert setup.
# CEREMONY_TLS_CERT=
# CEREMONY_TLS_KEY=
# OAuth secrets belong to the Bridge, never this frontend.

# Real Bridge + CCDP services on the fixed local origins above.
# CEREMONY_BRIDGE_BINARY=/absolute/path/to/libid-server-rs
# CEREMONY_SWS_BINARY=/absolute/path/to/static-web-server
# Defaults to the committed public registrations in dev/oauth-clients.json.
# Optional override for other registrations or a subset of platforms.
# CEREMONY_PLATFORMS=[{"id":"google","clientId":"PUBLIC_CLIENT_ID","versions":[1]}]
# NOTARY_URL=tcp://YOUR_NOTARY_HOST:7047
# GitHub's confidential credential stays in this ignored local file only.
# GH_OAUTH_CLIENT_SECRET=
