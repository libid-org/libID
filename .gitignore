# TypeScript
ts/node_modules/
ts/packages/*/node_modules/
ts/apps/*/node_modules/
ts/packages/*/dist/
ts/apps/*/dist/
ts/apps/demo/.env.local

# Demo static assets — staged by @libid/claim-full's libid-claim-assets
