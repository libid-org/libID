---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<nav class="section-switch" aria-label="Documentation section">
  <a href="/docs/" aria-current={siteTitleHref === '/docs/' ? 'true' : undefined}>Docs</a>
  <a href="/specs/" aria-current={siteTitleHref === '/specs/' ? 'true' : undefined}>Specs</a>
</nav>
<DefaultSidebar />

<style>
  .section-switch {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  a {
    flex: 1;
    padding: 0.5rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    text-align: center;
    text-decoration: none;
  }
  a:hover { color: var(--sl-color-white); }
  a[aria-current] {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
</style>
